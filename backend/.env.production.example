# ──────────────────────────────────────────
# Production Environment - HMEMS Backend (InfinityFree)
# ──────────────────────────────────────────
# Upload this file as .env to InfinityFree via FTP
# after filling in your actual values
# ──────────────────────────────────────────

APP_NAME="HMEMS"
APP_ENV=production
APP_DEBUG=false
# Generate with: php artisan key:generate (run locally)
APP_KEY=
# Change to your actual InfinityFree domain
APP_URL=https://hmems.infinityfreeapp.com

# ── Database (MySQL on InfinityFree) ──
# Get these from your InfinityFree cPanel -> MySQL Databases
DB_CONNECTION=mysql
DB_HOST=CHANGE_ME.sqlite.rules.host  # e.g. sql123.infinityfree.com
DB_PORT=3306
DB_DATABASE=CHANGE_ME  # e.g. if0_12345678_hmems
DB_USERNAME=CHANGE_ME  # e.g. if0_12345678
DB_PASSWORD=CHANGE_ME

# ── Session ──
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ── Cache ──
CACHE_STORE=file

# ── Queue (sync = no worker needed) ──
QUEUE_CONNECTION=sync

# ── Storage ──
FILESYSTEM_DISK=local

# ── CORS / Frontend ──
# Change to your actual Netlify frontend URL
FRONTEND_URL=https://hmems.netlify.app
SANCTUM_STATEFUL_DOMAINS=null
SESSION_DOMAIN=null

# ── Logging ──
LOG_CHANNEL=stack
LOG_LEVEL=warning

# ── Mail ──
MAIL_MAILER=log

# ── Broadcasting ──
BROADCAST_CONNECTION=log

# ── Auth ──
AUTH_GUARD=web